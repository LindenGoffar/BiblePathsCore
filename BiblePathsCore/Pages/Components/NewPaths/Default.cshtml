@model List<BiblePathsCore.Models.DB.Path>
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
<strong>Read one of our newest Paths</strong>
<br />
@foreach (var item in Model)
{
    @if (item.Type == (int)BiblePathsCore.Models.PathType.Commented)
    {
        <a href="/CommentedPaths/Read?PathId=@item.Id&MarkAsRead=1" class="text-decoration-none">
            @item.Name
        </a>

        <span class="badge rounded-pill bg-primary text-light">Commented</span>
    }
    else
    {
        <a href="/steps/step?id=@item.FirstStepId" class="text-decoration-none">
            @item.Name
        </a>
    }
    <br />
}
