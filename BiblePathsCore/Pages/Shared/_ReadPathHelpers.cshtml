
<script>
    // Let's go ahead and scroll to the selectedStep.
    $(document).ready(function () {
        var stepElement = $('#step-' + @ViewData["StepId"]);
        if (stepElement.length > 0) {
            $('html, body').animate({
                scrollTop: stepElement.offset().top - 300
            }, 300);
        }
    });
</script>
