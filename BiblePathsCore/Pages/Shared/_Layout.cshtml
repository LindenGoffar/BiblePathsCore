<!DOCTYPE html>
<html lang="en">
<head> 
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    @if (ViewBag.LoadIcons == true)
    {
        <script src="https://kit.fontawesome.com/0d29e3f93f.js" crossorigin="anonymous"></script>
    }
    @if (ViewBag.NoIndex == true)
    {
        <meta name="robots" content="noindex, nofollow">
    }

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=1.0.5" />
</head>
<body> 
@*Let's choose which image to use for the icon*@
    @{
        var isPbe = Context.Request.Path.Value?.Contains("/PBE") ?? false;
        var logoSrc = isPbe ? Url.Content("/images/PBE-logo_600px.png")
                           : Url.Content("/images/BiblePath-Logo.png");
        var logoTarget = isPbe ? "/PBE" : "/";
    }
    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
@*                 <a class="navbar-brand" asp-area="" asp-page="/Index">BiblePaths</a> *@
                <a href="@logoTarget" class="brand-link">
                    <img src="@logoSrc"
                         alt=""
                         aria-hidden="true"
                         class="brand-icon">
                    @*<span class="brand-text">BiblePaths</span> *@
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                    <partial name="_LoginPartial" />
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Paths/Index">Paths</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Shared/SelectChapter" asp-route-TargetPage="/Steps/Step">Study</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Paths/MyPaths">Path Builder</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/PBE/Index">PBE</a>
                        </li>
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/CommentedPaths/Index">Commented Paths</a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/HowTo/Index">Help</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div id="TopCenterMessage" class="bg-light text-info d-none"></div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - BiblePaths.Net - <a asp-area="" asp-page="/About">About</a> - <a asp-area="" asp-page="/Privacy">Privacy</a> 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/_FileDownload.js"></script>


    @RenderSection("Scripts", required: false)
</body>
</html>
