@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a href="@BrandHref" class="brand-link">
                <img src="@BrandLogo" alt="BiblePaths" class="brand-icon" />
@*                 <span class="brand-text">BiblePaths</span> *@
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                <LoginDisplay />
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link text-dark" href="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="/Paths/Index">Paths</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="/Shared/SelectChapter?TargetPage=/Steps/Step">Study</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="/Paths/MyPaths">Path Builder</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="/PBE/Index">PBE</a></li>
                    @* <li class="nav-item"><a class="nav-link text-dark" href="/CommentedPaths/Index">Commented Paths</a></li> *@
                    <li class="nav-item"><a class="nav-link text-dark" href="/HowTo/Index">Help</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div id="TopCenterMessage" class="bg-light text-info d-none"></div>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @Body
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; @DateTime.Now.Year - BiblePaths.Net - <a href="/About">About</a> - <a href="/Privacy">Privacy</a>
    </div>
</footer>

@code {
    private string BrandLogo { get; set; } = "/images/BiblePath-Logo.png";
    private string BrandHref { get; set; } = "/";

    protected override void OnInitialized()
    {
        UpdateBrand(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateBrand(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateBrand(string absoluteUri)
    {
        // Use AbsolutePath so query/fragment don't affect matching
        var path = new Uri(absoluteUri).AbsolutePath ?? string.Empty;
        var isPbe = path.Contains("/PBE/", StringComparison.OrdinalIgnoreCase);

        if (isPbe)
        {
            BrandLogo = "/images/PBE-logo_600px.png";
            BrandHref = "/PBE/";
        }
        else
        {
            BrandLogo = "/images/BiblePath-Logo.png";
            BrandHref = "/";
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}